# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lab_app?schema=public

# ── Authentication ────────────────────────────────────────────────────────────
# IMPORTANT: Generate strong random secrets (32+ chars). Never use defaults.
JWT_SECRET=your_strong_random_jwt_secret_here
NEXTAUTH_SECRET=your_strong_random_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ── API URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Use http://10.0.2.2:4000/api for the Android emulator.
# Use http://<your-computer-lan-ip>:4000/api for a physical Android device.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# ── Razorpay Payments ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# ── Twilio SMS / Calls ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lab Connect <noreply@labconnect.com>"

# ── Firebase Push Notifications ───────────────────────────────────────────────
FIREBASE_PROJECT_ID=

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── AWS S3 (Report uploads) ──────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Deployment (optional) ────────────────────────────────────────────────────
# WEB_URL=https://your-production-domain.com
# PORT=4000
