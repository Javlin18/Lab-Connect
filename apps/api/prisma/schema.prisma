generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  employee
  patient
}

enum AppointmentStatus {
  pending
  assigned
  accepted
  en_route
  collected
  processing
  completed
}

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  phone               String         @unique
  role                UserRole
  createdAt           DateTime       @default(now())
  passwordHash        String
  patientAppointments Appointment[]  @relation("PatientAppointments")
  assignedAppointments Appointment[] @relation("EmployeeAppointments")
  adminAppointments   Appointment[]  @relation("AdminAppointments")
  uploadedResults     TestResult[]   @relation("UploadedResults")
  notifications       Notification[]
  employeeProfile     Employee?
  cart                Cart?
  orders              Order[]

  @@index([role])
}

model Appointment {
  id         String            @id @default(cuid())
  patientId  String
  employeeId String?
  adminId    String
  testTypes  String[]
  address    String
  slot       String
  status     AppointmentStatus @default(pending)
  notes      String            @default("")
  barcodes   Json?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  patient    User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  employee   User?             @relation("EmployeeAppointments", fields: [employeeId], references: [id], onDelete: SetNull)
  admin      User              @relation("AdminAppointments", fields: [adminId], references: [id], onDelete: Cascade)
  testResult TestResult?
  order      Order?
  reassignRequests ReassignRequest[]

  @@index([patientId])
  @@index([employeeId])
  @@index([status])
  @@index([slot])
}

model TestResult {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  reportUrl     String
  uploadedAt    DateTime    @default(now())
  uploadedBy    String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  uploader      User        @relation("UploadedResults", fields: [uploadedBy], references: [id], onDelete: Cascade)
}

model Employee {
  id              String  @id @default(cuid())
  userId          String  @unique
  zone            String
  isAvailable     Boolean @default(true)
  currentLocation String  @default("")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAvailable])
  @@index([zone])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model Test {
  id                      String     @id @default(cuid())
  name                    String
  slug                    String     @unique
  description             String
  price                   Float
  discountPrice           Float?
  category                String
  sampleType              String
  preparationInstructions String
  parameters              String[]
  turnaroundHours         Int
  isActive                Boolean    @default(true)
  packages                Package[]  @relation("PackageTests")
  cartItems               CartItem[]
  createdAt               DateTime   @default(now())
}

model Package {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  description   String
  price         Float
  discountPrice Float?
  tests         Test[]     @relation("PackageTests")
  isActive      Boolean    @default(true)
  cartItems     CartItem[]
  createdAt     DateTime   @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  patientId String     @unique
  patient   User       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  testId    String?
  test      Test?    @relation(fields: [testId], references: [id], onDelete: Cascade)
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model Order {
  id                 String       @id @default(cuid())
  patientId          String
  patient            User         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items              Json
  totalAmount        Float
  paymentId          String?
  paymentType        String       @default("online_prepaid")  // 'online_prepaid' | 'pay_on_collection'
  paymentStatus      String       @default("pending")          // 'pending' | 'paid' | 'failed' | 'refunded'
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  paymentLinkId      String?
  paymentLinkUrl     String?
  paidAt             DateTime?
  paymentMethod      String?                                     // 'online' | 'upi_manual' | 'cash'
  manualTransactionId String?                                    // UPI transaction ref entered by employee
  appointmentId      String?      @unique
  appointment        Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
}

model SystemSetting {
  key   String @id
  value String
}

model CallLog {
  id         String   @id @default(cuid())
  callSid    String   @unique
  fromPhone  String
  toPhone    String
  patientId  String?
  employeeId String?
  duration   Int?
  status     String
  createdAt  DateTime @default(now())

  @@index([patientId])
}

model ReassignRequest {
  id            String    @id @default(cuid())
  appointmentId String
  requestedBy   String
  reason        String
  note          String?
  status        String    @default("pending")
  resolvedBy    String?
  newEmployeeId String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([status])
}
