{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lab-connect-9aby.onrender.com/api"
      },
      "node": "22.16.0",
      "pnpm": "11.2.2"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lab-connect-9aby.onrender.com/api",
        "NODE_PATH": "../../node_modules"
      },
      "node": "22.16.0",
      "pnpm": "11.2.2"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "node": "22.16.0",
      "pnpm": "11.2.2"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal"
      }
    }
  }
}
