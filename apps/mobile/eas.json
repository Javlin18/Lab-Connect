{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "node": "20.19.4",
      "pnpm": "9.12.3"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "node": "20.19.4",
      "pnpm": "9.12.3"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "node": "20.19.4",
      "pnpm": "9.12.3"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal"
      }
    }
  }
}
