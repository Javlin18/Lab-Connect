{
  "name": "lab-app",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm --filter @lab-app/api build && pnpm --filter @lab-app/web build",
    "build:mobile": "pnpm --filter @lab-app/mobile build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "prisma:generate": "prisma generate"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.1",
    "turbo": "^2.0.14",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0"
  }
}
