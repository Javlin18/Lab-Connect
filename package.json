{
  "name": "lab-app",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "bash scripts/hostinger-build.sh",
    "build:mobile": "pnpm --filter @lab-app/mobile build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:migrate": "./node_modules/.bin/prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:push": "./node_modules/.bin/prisma db push --schema apps/api/prisma/schema.prisma",
    "prisma:generate": "./node_modules/.bin/prisma generate --schema apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "turbo": "^2.0.14"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/node": "^22.7.4",
    "dotenv": "^17.4.2",
    "prisma": "5.22.0",
    "typescript": "^5.5.4"
  }
}
